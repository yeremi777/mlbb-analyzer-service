{
    "swagger": "2.0",
    "info": {
        "description": "Serves the MLBB hero, counter, and synergy dataset from Postgres and returns AI-scored counter recommendations for frontend consumption.",
        "title": "MLBB Analyzer Service",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Root",
                "responses": {
                    "200": {
                        "description": "Hello, World!",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/counters/analyze-detail": {
            "post": {
                "description": "Returns summary, strengths, conditions, and failure cases for one target/counter pair, grounded only in authored proof evidence.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "counters"
                ],
                "summary": "Explain one counter matchup in detail",
                "parameters": [
                    {
                        "description": "Target hero, counter hero, and output language",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.AnalyzeCounterDetailRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.AnalyzeCounterDetailResponse"
                        }
                    },
                    "404": {
                        "description": "target_hero_not_found, counter_hero_not_found, counter_matchup_not_found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limit_exceeded",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "ai_provider_error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "rate_limit_unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "ai_provider_not_configured",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/counters/analyze-score": {
            "post": {
                "description": "Returns AI-produced score and confidence for every counter matchup of the target hero, ranked best-first. Cached results do not consume rate-limit quota.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "counters"
                ],
                "summary": "Score all counter matchups for one target hero",
                "parameters": [
                    {
                        "description": "Target hero and output language",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.AnalyzeCounterScoreRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.AnalyzeCounterScoreResponse"
                        }
                    },
                    "404": {
                        "description": "target_hero_not_found, counter_data_not_found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limit_exceeded",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "ai_provider_error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "rate_limit_unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "ai_provider_not_configured",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/heroes": {
            "get": {
                "description": "Returns heroes from the dataset with search, role, lane, and pagination filters.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "heroes"
                ],
                "summary": "List heroes",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Case-insensitive search by hero name",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "tank",
                        "description": "Case-insensitive role filter",
                        "name": "role",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "roam",
                        "description": "Case-insensitive lane filter",
                        "name": "lane",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "1-based page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Heroes per page (1-100)",
                        "name": "size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.HeroListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/heroes/{heroId}": {
            "get": {
                "description": "Returns one hero by dataset UID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "heroes"
                ],
                "summary": "Get hero detail",
                "parameters": [
                    {
                        "type": "string",
                        "example": "tigreal",
                        "description": "Hero UID",
                        "name": "heroId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Hero"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/heroes/{heroId}/counters": {
            "get": {
                "description": "Returns authored counter matchups for one target hero, with counter hero details joined in.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "heroes"
                ],
                "summary": "List hero counters",
                "parameters": [
                    {
                        "type": "string",
                        "example": "tigreal",
                        "description": "Target hero UID",
                        "name": "heroId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.CounterMatchup"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/heroes/{heroId}/synergies": {
            "get": {
                "description": "Returns authored synergy pairings for one anchor hero, with partner hero details joined in.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "heroes"

# 127.0.0.1 keeps the API on loopback, reachable through a reverse proxy or
# tunnel only. Set 0.0.0.0 to expose it directly on the host's interfaces.
API_HOST=127.0.0.1
API_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mlbb_analyzer
DB_USERNAME=postgres
DB_PASSWORD=root

# Redis configuration for caching and rate limiting
# Use url for hosted Redis providers. If url is set, it overrides host/port/db.
# REDIS_URL=redis://127.0.0.1:6379/0
# With a password: redis://:the-password@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Rate limiting settings
RATE_LIMIT_ENABLED=false
RATE_LIMIT_ANALYZE_MAX_REQUESTS=5
RATE_LIMIT_ANALYZE_WINDOW_SECONDS=18000
RATE_LIMIT_ANALYZE_DETAIL_MULTIPLIER=3
RATE_LIMIT_COOKIE_NAME=mlbb_analyzer_client_id
RATE_LIMIT_COOKIE_MAX_AGE_SECONDS=2592000
# Use RATE_LIMIT_COOKIE_SECURE=true and RATE_LIMIT_COOKIE_SAMESITE=none for HTTPS
# frontend/backend deployments on separate domains.
RATE_LIMIT_COOKIE_SECURE=false
RATE_LIMIT_COOKIE_SAMESITE=lax
RATE_LIMIT_SALT=change-this-to-a-random-secret


# Comma-separated browser origins (local dev origin is always allowed).
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Preferred: comma-separated fallback order. AI_PROVIDER=openrouter still works.
# Example fallback order: AI_PROVIDERS=openrouter,opencode_zen,openai
# AI_PROVIDER=openai
AI_PROVIDERS=openrouter,opencode_zen
AI_TIMEOUT_SECONDS=20
AI_ANALYSIS_CACHE_TTL_SECONDS=600
AI_ANALYSIS_CACHE_MAX_ENTRIES=256

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SERVER_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=MLBB Analyzer Service
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000

OPENCODE_ZEN_API_KEY=<YOUR_OPENCODE_ZEN_API_KEY>
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
OPENCODE_ZEN_SERVER_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_ENDPOINT_TYPE=chat_completions


# Collector HTTP User-Agent; defaults to a descriptive polite one.
# COLLECTOR_USER_AGENT=
# Override the Moonton base URL. Only for pointing a run at a stub; unset in production.
# COLLECTOR_BASE_URL=

# Patch calendar collector (collector patches). Both have working defaults: the
# User-Agent is the same polite string the stats collector sends, and the base
# URL is Liquipedia's MediaWiki endpoint. Override the URL only to point a run
# at a stub; Liquipedia's terms require the contact details in the User-Agent.
# LIQUIPEDIA_USER_AGENT=
# LIQUIPEDIA_BASE_URL=